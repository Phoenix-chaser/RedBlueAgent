# =============================================================================
# PentestAgent 环境配置
# 使用方法: 复制此文件为 .env，填入一个 API Key 即可
# =============================================================================

# =============================================================================
# 第一步: 选择并填入一个 LLM 提供商的 API Key
# =============================================================================

# ---- 国产模型 (推荐，国内访问快) ----

# DeepSeek 深度求索 - 性价比最高，有免费额度
# 获取 Key: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat          # DeepSeek-V3（推荐）
# LLM_MODEL=deepseek-reasoner      # DeepSeek-R1（推理更强）

# Kimi 月之暗面 - 超长上下文
# 获取 Key: https://platform.moonshot.cn/
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_PROVIDER=moonshot
# LLM_MODEL=moonshot-v1-32k
# LLM_MODEL=moonshot-v1-128k       # 超长上下文版

# GLM 智谱AI - 有免费额度
# 获取 Key: https://open.bigmodel.cn/
# ZHIPU_API_KEY=xxxxxxxxxxxxxxxx
# LLM_PROVIDER=zhipu
# LLM_MODEL=glm-4
# LLM_MODEL=glm-4-flash            # 轻量快速版（更便宜）

# ---- 国际模型 ----

# Anthropic Claude
# 获取 Key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6

# OpenAI GPT
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o

# =============================================================================
# 第二步: 以下设置保持默认即可
# =============================================================================

# Token 限制
LLM_MAX_TOKENS=8192

# 安全设置 (true=危险操作需要人工确认)
REQUIRE_APPROVAL_FOR_EXPLOITS=true
AUTO_APPROVE_SCAN_ONLY=true

# 存储目录
SESSIONS_DIR=data/sessions
REPORTS_DIR=data/reports
AUDIT_LOG_FILE=data/audit.log

# 日志级别: DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# RAG 知识库 (可选，不填也能正常工作)
KNOWLEDGE_BASE_DIR=data/knowledge_base
EMBEDDING_MODEL=all-MiniLM-L6-v2

# HuggingFace 镜像 (国内网络必填，解决 huggingface.co 无法访问问题)
HF_ENDPOINT=https://hf-mirror.com
